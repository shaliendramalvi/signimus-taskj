class BankAccount {
    private int balance;

    public BankAccount(int balance) {
        this.balance = balance;
    }

    // Synchronized withdrawal method to ensure thread safety
    public synchronized void withdraw(int amount, String name) {
        if (amount > balance) {
            System.out.println(name + " attempted to withdraw $" + amount + " but insufficient balance.");
        } else {
            System.out.println(name + " is withdrawing $" + amount);
            balance -= amount;
            System.out.println("New balance after " + name + "'s withdrawal: $" + balance);
        }
    }

    public int getBalance() {
        return balance;
    }
}

// Thread class for withdrawing money
class WithdrawThread extends Thread {
    private BankAccount account;
    private int amount;
    private String user;

    public WithdrawThread(BankAccount account, int amount, String user) {
        this.account = account;
        this.amount = amount;
        this.user = user;
    }

    @Override
    public void run() {
        account.withdraw(amount, user);
    }
}

public class BankSystem {
    public static void main(String[] args) {
        BankAccount account = new BankAccount(500); // Initial balance

        // Creating multiple withdrawal threads
        Thread t1 = new WithdrawThread(account, 200, "Alice");
        Thread t2 = new WithdrawThread(account, 300, "Bob");
        Thread t3 = new WithdrawThread(account, 100, "Charlie");

        // Start the threads
        t1.start();
        t2.start();
        t3.start();
    }
}
