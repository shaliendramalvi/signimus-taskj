1.class Pair<T, U> {
    private T first;
    private U second;

    // Constructor
    public Pair(T first, U second) {
        this.first = first;
        this.second = second;
    }

    // Getters
    public T getFirst() {
        return first;
    }

    public U getSecond() {
        return second;
    }

    // Setters
    public void setFirst(T first) {
        this.first = first;
    }

    public void setSecond(U second) {
        this.second = second;
    }

    @Override
    public String toString() {
        return "(" + first + ", " + second + ")";
    }
}

// Example Usage
public class GenericPairExample {
    public static void main(String[] args) {
        Pair<String, Integer> student = new Pair<>("Alice", 21);
        System.out.println("Original Pair: " + student);

        student.setFirst("Bob");
        student.setSecond(22);
        System.out.println("Updated Pair: " + student);
    }
}

2.class Utils {
    // Generic swap method
    public static <T> void swap(Pair<T, T> pair) {
        T temp = pair.getFirst();
        pair.setFirst(pair.getSecond());
        pair.setSecond(temp);
    }
}

// Example Usage
public class GenericSwapExample {
    public static void main(String[] args) {
        Pair<Integer, Integer> numbers = new Pair<>(10, 20);
        System.out.println("Before Swap: " + numbers);
        
        Utils.swap(numbers);
        System.out.println("After Swap: " + numbers);
    }
}

3.class MathUtils {
    // Generic method to find the maximum of three numbers
    public static <T extends Comparable<T>> T findMax(T a, T b, T c) {
        T max = a;
        if (b.compareTo(max) > 0) max = b;
        if (c.compareTo(max) > 0) max = c;
        return max;
    }
}

// Example Usage
public class GenericMaxExample {
    public static void main(String[] args) {
        System.out.println("Max of 3, 7, 5: " + MathUtils.findMax(3, 7, 5));
        System.out.println("Max of 4.5, 2.3, 6.8: " + MathUtils.findMax(4.5, 2.3, 6.8));
        System.out.println("Max of Apple, Orange, Banana: " + MathUtils.findMax("Apple", "Orange", "Banana"));
    }
}
